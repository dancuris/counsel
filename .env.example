# Neon Postgres connection string.
DATABASE_URL=

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Random 32+ char string used to sign the auth cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Google Cloud project (console.cloud.google.com) -> APIs & Services ->
# Credentials -> OAuth client ID (Web application). Add both your local and
# production origins' /api/auth/google/callback URLs as authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this Google account is allowed to sign in.
ALLOWED_EMAIL=
